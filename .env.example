APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adledger_laravel
DB_USERNAME=root
DB_PASSWORD=

# Session stays unlocked for 3 hours (original app's AUTH_SESSION_TTL)
AUTH_SESSION_TTL=10800

SESSION_DRIVER=file
SESSION_LIFETIME=180
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# ── GAM (Google Ad Manager) API sync ──
GAM_ENABLED=false
# GAM_MOCK=false
# Pull GAM data directly (app-managed hidden reports). false = use the ADX page's saved report IDs.
# GAM_DIRECT_REPORTS=true
# GAM_REPORT_API=soap            # soap = ad-hoc report jobs, nothing saved in GAM; rest = hidden REST reports
# Set to 100 if the hourly report's CTR comes back as a 0..1 ratio (stored as %).
# GAM_HOURLY_CTR_SCALE=1
# Daily report metric positions (Revenue=0, CTR, Impressions, Requests, Clicks); -1 skips.
# GAM_COL_CTR=1
# GAM_COL_IMPRESSIONS=2
# GAM_COL_REQUESTS=3
# GAM_COL_CLICKS=4
# GAM_CTR_SCALE=100
# Ad unit creation (Domains page). Needs the service account to have the `dfp`
# scope + inventory-write permission. Parent empty = the network's root ad unit.
# GAM_SOAP_VERSION=v202605
# GAM_APP_NAME=Amaira
# GAM_AD_UNIT_PARENT=
# GAM_AD_UNIT_TARGET=BLANK

# ── Meta (Facebook) API sync ──
META_ENABLED=false
# META_MOCK=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
